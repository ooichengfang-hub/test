# Read-only Binance API key (Enable Reading only — never enable withdrawals)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Optional: regional account API if api.binance.com is blocked from your network
# BINANCE_API_BASE=https://api.binance.com
# BINANCE_API_BASE=https://api.binance.us

# Optional: public market data CDN (works from restricted regions)
# BINANCE_DATA_API=https://data-api.binance.vision
